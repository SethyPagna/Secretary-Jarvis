{
  "name": "@jarvis/hud",
  "version": "0.1.0",
  "description": "Secretary Jarvis local-first cinematic HUD shell.",
  "author": "Secretary Jarvis",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build && tsc -p tsconfig.electron.json",
    "build:electron": "tsc -p tsconfig.electron.json",
    "dev": "npm run build:electron && vite --host 127.0.0.1 --port 5175",
    "start": "electron dist-electron/main.js",
    "electron": "npm run build:electron && electron dist-electron/main.js",
    "package": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --win portable nsis"
  },
  "build": {
    "appId": "com.secretaryjarvis.hud",
    "productName": "Secretary Jarvis HUD",
    "electronVersion": "39.2.7",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "dist-electron/main.js"
    },
    "win": {
      "signAndEditExecutable": false,
      "target": [
        "portable",
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Secretary Jarvis HUD"
    }
  },
  "dependencies": {
    "@jarvis/core": "0.1.0",
    "@react-three/fiber": "^9.4.2",
    "framer-motion": "^12.23.26",
    "lucide-react": "^0.561.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "three": "^0.182.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.181.0",
    "electron": "^39.2.7",
    "electron-builder": "^26.8.1"
  }
}
