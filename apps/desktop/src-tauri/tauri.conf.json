{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Jarvis",
  "version": "0.1.0",
  "identifier": "local.jarvis.desktop",
  "build": {
    "frontendDist": "../../dashboard/dist",
    "devUrl": "http://127.0.0.1:5174"
  },
  "app": {
    "windows": [
      {
        "title": "Jarvis",
        "width": 1180,
