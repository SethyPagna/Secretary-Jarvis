{
  "name": "jarvis-agent",
  "productName": "JARVIS",
  "version": "1.0.0",
  "description": "JARVIS desktop agent with an embedded Python backend, local model orchestration, and voice readiness checks.",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "postinstall": "echo 'JARVIS desktop dependencies ready.'",
    "jarvis:setup": "powershell -ExecutionPolicy Bypass -File setup-jarvis.ps1",
    "jarvis:run": "powershell -ExecutionPolicy Bypass -File run-jarvis.ps1",
    "jarvis:stop": "powershell -ExecutionPolicy Bypass -File stop-jarvis.ps1",
    "desktop:dev": "electron .",
    "desktop:build": "powershell -ExecutionPolicy Bypass -File scripts/build-desktop.ps1 -PyInstallerSpec packaging/jarvis-backend.spec",
    "desktop:pack": "electron-builder"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SethyPagna/Secretary-Jarvis.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/SethyPagna/Secretary-Jarvis/issues"
  },
  "homepage": "https://github.com/SethyPagna/Secretary-Jarvis#readme",
  "dependencies": {
    "agent-browser": "^0.26.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.sethypagna.jarvis",
    "productName": "JARVIS",
    "afterPack": "scripts/after-pack-icon.cjs",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "jarvis_cli/web_dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist/jarvis-backend",
        "to": "backend"
      },
      {
        "from": "assets",
        "to": "assets"
      },
      {
        "from": "skills",
        "to": "skills"
      },
      {
        "from": "optional-skills",
        "to": "optional-skills"
      }
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "assets/icon.ico",
      "signAndEditExecutable": false
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "assets/icon.icns",
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "assets/icon.png"
    }
  },
  "overrides": {
    "lodash": "4.18.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
